{
  "id": "cv-pseudo",
  "title": "Pseudo",
  "description": "Pseudo, a pseudodragon familiar for the GM: a system-neutral AI assistant that reads your world — journals, actors, monsters, roll tables, cards, and compendia — to name things, answer lore and rules questions, and help run the game.",
  "version": "0.0.14",
  "compatibility": {
    "minimum": 14,
    "verified": 14
  },
  "authors": [
    {
      "name": "Jeff & Antigravity"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "remote-highlight-ui",
        "type": "module",
        "reason": "Pseudo uses it to spotlight the exact UI element an answer refers to.",
        "manifest": "https://github.com/shemetz/remote-highlight-ui/releases/latest/download/module.json"
      },
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Required by Remote Highlight UI.",
        "manifest": "https://github.com/ruipin/fvtt-lib-wrapper/releases/latest/download/module.json"
      },
      {
        "id": "spotlight-omnisearch",
        "type": "module",
        "reason": "Pseudo reads its prebuilt search index to answer questions about your world's content.",
        "manifest": "https://github.com/theripper93/spotlight-omnisearch/releases/latest/download/module.json"
      }
    ]
  },
  "esmodules": [
    "scripts/cv-pseudo.mjs"
  ],
  "styles": [
    "styles/cv-pseudo.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/DJFalstaff/cv-pseudo",
  "manifest": "https://github.com/DJFalstaff/cv-pseudo/releases/latest/download/module.json",
  "download": "https://github.com/DJFalstaff/cv-pseudo/releases/latest/download/module.zip",
  "bugs": "https://discord.gg/cartoon-villains"
}
